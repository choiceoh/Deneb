{
  "globs": ["docs/**/*.md", "docs/**/*.mdx", "README.md"],
  "ignores": ["docs/reference/templates/**", "**/.local/**"],
  "config": {
    "default": true,

    "MD013": false,
    "MD025": false,

    // Research/design notes intentionally repeat parallel sub-section headings
    // (per-model, per-paper, per-feature), so allow identical heading text as
    // long as it is not a direct sibling under the same parent.
    "MD024": { "siblings_only": true },
    // Stacked blockquote callouts separated by blank lines are intentional here.
    "MD028": false,

    "MD029": false,

    "MD033": {
      "allowed_elements": [
        "Note",
        "Info",
        "Tip",
        "Warning",
        "Card",
        "CardGroup",
        "Columns",
        "Steps",
        "Step",
        "Tabs",
        "Tab",
        "Accordion",
        "AccordionGroup",
        "CodeGroup",
        "Frame",
        "Callout",
        "ParamField",
        "ResponseField",
        "RequestExample",
        "ResponseExample",
        "img",
        "a",
        "br",
        "details",
        "summary",
        "p",
        "strong",
        "picture",
        "source",
        "Tooltip",
        "Check",
      ],
    },

    "MD036": false,
    "MD040": false,
    "MD041": false,
    "MD046": false,
  },
}
