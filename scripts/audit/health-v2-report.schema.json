{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/choiceoh/Deneb/schemas/health-v2-report.schema.json",
  "title": "Deneb Health Bench 2.0 report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rubric_version",
    "profile",
    "revision",
    "score",
    "pillars",
    "findings",
    "interventions",
    "readiness",
    "evidence_status"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "rubric_version": { "const": "2.2.1" },
    "profile": { "enum": ["fast", "deep"] },
    "revision": { "type": "string", "minLength": 7 },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "confidence", "healthy"],
      "properties": {
        "overall": { "type": "number", "minimum": 0, "maximum": 100 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
        "healthy": { "type": "boolean" }
      }
    },
    "pillars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "weight", "score", "intent", "metrics", "findings"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "exclusiveMinimum": 0 },
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "intent": { "type": "string", "minLength": 1 },
          "metrics": { "type": "object" },
          "findings": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pillar", "severity", "path", "evidence", "why", "remediation", "verify", "priority", "related_paths"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "pillar": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "path": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 },
          "remediation": { "type": "string", "minLength": 1 },
          "verify": { "type": "string", "minLength": 1 },
          "priority": { "type": "number", "minimum": 0, "maximum": 100 },
          "related_paths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "interventions": { "type": "array", "items": { "type": "object" } },
    "readiness": {
      "type": "object",
      "additionalProperties": { "type": ["boolean", "null"] }
    },
    "evidence_status": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "detail", "required"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["measured", "unavailable", "not_applicable"] },
          "detail": { "type": "string" },
          "required": { "type": "boolean" }
        }
      }
    }
  }
}
