# Nemotron embed adapter — Deneb /embed contract on 8002, translating to the
# NVFP4 vLLM container on 8003 (see nemotron-vllm.service). Stdlib-only:
# system python3, no venv.
[Unit]
Description=Nemotron Embed Adapter (Deneb semantic index, port 8002)
After=network.target nemotron-vllm.service
Wants=nemotron-vllm.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/deneb/scripts/deploy/nemotron-embed-server.py --port 8002 --backend http://127.0.0.1:8003
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
