[Unit]
Description=Deneb health-finding miner (codebase/runtime health defects -> L4 candidates)
# Bound the retry stanza in [Service]: a genuinely broken miner still fails.
StartLimitIntervalSec=1d
StartLimitBurst=4

[Service]
Type=oneshot
# python3 is system-wide, but the miner shells out to the benches which need the
# Go toolchain; ~/.local/bin carries the go symlink (same lesson as coding-dispatch).
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/deneb
# The miner runs the benches LIVE (no --report args here): health-bench-v3 has a
# 900s budget, runtime-health 300s, and rsi-bench another 600s when an rsi.bench.*
# contract is pending. systemd's default TimeoutStartSec is 90s, which would
# SIGTERM the run mid-bench and hand this lane the exact "exists but never
# completes" failure the timers were installed to end. Sized above the sum.
TimeoutStartSec=40min
ExecStart=%h/deneb/scripts/audit/health-finding-miner.py

# A miner's nonzero exits are all transient infrastructure (audit tooling or the
# gateway RPC unreachable), never "nothing to file" — so a single blip must not
# cost a whole cadence. 2026-08-18: a DNS outage broke `go run …deadcode@latest`
# and the weekly deadcode miner stayed dead for 5 days, starving L4 supply while
# 3 fileable findings waited. Bounded so a genuinely broken miner still fails.
Restart=on-failure
RestartSec=30min
