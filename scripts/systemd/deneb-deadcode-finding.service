[Unit]
Description=Deneb deadcode-finding miner (new dead code vs baseline -> L4 candidates)
# Bound the retry stanza in [Service]: a genuinely broken miner still fails.
StartLimitIntervalSec=1d
StartLimitBurst=4

[Service]
Type=oneshot
# deadcode-audit.sh runs `go run golang.org/x/tools/cmd/deadcode@latest`; the
# systemd user manager's minimal PATH lacks the go symlink under ~/.local/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/deneb
# Whole-program reachability over all gateway binaries: ~1-2 min, plus a cold
# module fetch on the first run after a toolchain bump.
TimeoutStartSec=20min
ExecStart=%h/deneb/scripts/audit/deadcode-finding-miner.py

# A miner's nonzero exits are all transient infrastructure (audit tooling or the
# gateway RPC unreachable), never "nothing to file" — so a single blip must not
# cost a whole cadence. 2026-08-18: a DNS outage broke `go run …deadcode@latest`
# and the weekly deadcode miner stayed dead for 5 days, starving L4 supply while
# 3 fileable findings waited. Bounded so a genuinely broken miner still fails.
Restart=on-failure
RestartSec=30min
