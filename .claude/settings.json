{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/dev/codegraph-autoindex.py\"",
            "timeout": 15,
            "statusMessage": "codegraph: 워크트리 인덱스 자동 준비"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/dev/session-memory-surface.py\"",
            "timeout": 10,
            "statusMessage": "기억: 최근 세션·결정 표면화"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v clash >/dev/null 2>&1 || exit 0; exec clash check",
            "timeout": 10,
            "statusMessage": "clash: 워크트리 충돌 검사"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/dev/claude-rules-gate.py\"",
            "timeout": 10,
            "statusMessage": "rules-gate: 경로별 룰 첫 접촉 안내"
          }
        ]
      },
      {
        "matcher": "Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/dev/codegraph-nudge.py\"",
            "timeout": 10,
            "statusMessage": "codegraph: 심볼 검색은 CodeGraph로 유도"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/dev/codegraph-remind.py\"",
            "timeout": 10,
            "statusMessage": "codegraph: 소스 탐색 시 1회 안내"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/dev/zcode-codegraph-sync.sh\"",
            "timeout": 5,
            "statusMessage": "codegraph: 편집 후 인덱스 자동동기"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/dev/session-memory-capture.py\"",
            "timeout": 20,
            "statusMessage": "기억: 세션 골격 자동 기록"
          }
        ]
      }
    ]
  }
}
